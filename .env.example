# Database
DATABASE_URL="postgresql://luxeuser:luxepass@localhost:5432/luxeshop"
REDIS_URL="redis://localhost:6379"

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
JWT_SECRET="your-jwt-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Email ───────────────────────────────────────────────────────────────────
# Transport: "resend" | "smtp" | "auto" (auto = prefer Resend, fall back to SMTP).
# With neither configured, emails are logged instead of sent — nothing breaks.
EMAIL_PROVIDER="auto"

# Sender used by every template. A display name is optional:
#   EMAIL_FROM="Vibio <contact@vibio.ma>"
EMAIL_FROM="noreply@yourbrand.com"

# Option A — Resend (HTTP API). Requires adding DNS TXT records to verify the
# sending domain; without that it only delivers to the account owner's address.
RESEND_API_KEY="re_..."

# Option B — SMTP (cPanel mailbox or any SMTP server). Authenticates with the
# mailbox login, so it needs NO DNS changes — use this when TXT records can't be
# added to the production domain. Port 465 = implicit TLS; 587 = STARTTLS
# (set SMTP_SECURE="false" for 587).
SMTP_HOST="mail.yourbrand.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@yourbrand.com"
SMTP_PASS=""

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ── Store-owner order notifications ─────────────────────────────────────────
# Where the "new order" alerts go (never hardcoded). Leave blank to disable a channel.
STORE_NOTIFICATION_EMAIL="owner@yourbrand.com"
STORE_NOTIFICATION_PHONE="+212600000000"       # E.164; phone/WhatsApp fallback for all alerts
STORE_WHATSAPP_NUMBER=""                        # optional; overrides the phone for WhatsApp alerts
# When to notify the owner: "created" (default, fire on order placement) or
# "paid" (defer online-payment orders until payment settles; COD still fires immediately).
ADMIN_ORDER_NOTIFY_ON="created"
# Admin deep-link base for the order link in notifications (defaults to NEXT_PUBLIC_SITE_URL).
ADMIN_SITE_URL="http://localhost:3000"

# WhatsApp provider selection: "meta" | "twilio" | "auto" (auto = whichever is configured).
WHATSAPP_PROVIDER="auto"
# Meta WhatsApp Cloud API (used when WHATSAPP_PROVIDER=meta):
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_API_VERSION="v21.0"   # optional, defaults to v21.0

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="..."

# App URLs
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payment (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Store contact for customer "Order by phone"
NEXT_PUBLIC_STORE_PHONE_NUMBER="+212600000000"
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER="212600000000"
