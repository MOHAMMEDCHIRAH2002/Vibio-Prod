generator client {
  provider      = "prisma-client-js"
  // "native" covers the local host (dev). The musl+openssl-3 target is the
  // engine needed inside node:20-alpine (Docker), which ships OpenSSL 3.x.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PromoType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum LoyaltyTxnType {
  EARN // points granted for a paid/delivered order
  REDEEM // points spent at checkout for a discount
  REVERSE // points removed (order canceled/refunded) or redeemed points refunded
}

enum SubmissionType {
  CONTACT
  CALLBACK
  PRODUCT_INQUIRY
  NEWSLETTER
  ORDER_MODIFICATION
  SUPPORT
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  phone               String?
  passwordHash        String?
  role                Role                 @default(CUSTOMER)
  emailVerified       DateTime?
  image               String?
  addresses           Address[]
  orders              Order[]
  wishlist            Wishlist[]
  reviews             Review[]
  loyaltyPoints       Int                  @default(0) // current redeemable balance (denormalized from the ledger)
  loyaltyTransactions LoyaltyTransaction[]
  refreshToken        String?
  resetToken          String?
  resetTokenExpires   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("users")
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  isDefault  Boolean @default(false)

  @@index([userId])
  @@map("addresses")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  sortOrder   Int        @default(0)

  @@map("categories")
}

model Product {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  name         String
  description  String                   @db.Text
  shortDesc    String?
  images       String[]
  categoryId   String
  category     Category                 @relation(fields: [categoryId], references: [id])
  tags         Tag[]
  variants     Variant[]
  basePrice    Decimal                  @db.Decimal(10, 2)
  comparePrice Decimal?                 @db.Decimal(10, 2)
  isFeatured   Boolean                  @default(false)
  isActive     Boolean                  @default(true)
  metaTitle    String?
  metaDesc     String?
  weight       Float?
  searchVector Unsupported("tsvector")?
  reviews      Review[]
  orderItems   OrderItem[]
  wishlist     Wishlist[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([searchVector], type: Gin)
  @@index([categoryId])
  // Add index for price sorting used in storefront queries
  @@index([basePrice])
  @@index([isActive, createdAt])
  @@index([isFeatured, isActive])
  @@map("products")
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  value      String
  price      Decimal     @db.Decimal(10, 2)
  stock      Int         @default(0)
  sku        String?     @unique
  orderItems OrderItem[]

  @@index([productId])
  @@map("variants")
}

model Tag {
  id       String     @id @default(cuid())
  name     String     @unique
  slug     String     @unique
  products Product[]
  posts    BlogPost[]

  @@map("tags")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  items               OrderItem[]
  status              OrderStatus          @default(PENDING)
  paymentStatus       PaymentStatus        @default(PENDING)
  paymentMethod       String?
  paymentIntentId     String?
  shippingAddress     Json
  subtotal            Decimal              @db.Decimal(10, 2)
  shippingCost        Decimal              @db.Decimal(10, 2)
  discount            Decimal              @default(0) @db.Decimal(10, 2)
  loyaltyDiscount     Decimal              @default(0) @db.Decimal(10, 2) // MAD discount funded by redeemed points
  pointsRedeemed      Int                  @default(0) // loyalty points spent on this order
  pointsEarned        Int                  @default(0) // loyalty points awarded once paid/delivered
  total               Decimal              @db.Decimal(10, 2)
  promoCodeId         String?
  promoCode           PromoCode?           @relation(fields: [promoCodeId], references: [id])
  loyaltyTransactions LoyaltyTransaction[]
  notes               String?
  trackingNumber      String?
  // Idempotency: a retried create with the same key returns the existing order
  // instead of creating a duplicate (and therefore never re-notifies).
  idempotencyKey      String?              @unique
  // Set once the store-owner "new order" notification has been dispatched, so
  // the notification fires at most once per order even if triggered again.
  adminNotifiedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id])
  name        String
  variantName String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  image       String?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─── Promotions & Content ────────────────────────────────────────────────────

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  type        PromoType
  value       Decimal   @db.Decimal(10, 2)
  minOrder    Decimal?  @db.Decimal(10, 2)
  maxDiscount Decimal?  @db.Decimal(10, 2) // optional cap on the discount (percentage codes)
  maxUses     Int?
  usedCount   Int       @default(0)
  startsAt    DateTime? // code is invalid before this time
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  orders      Order[]

  @@map("promo_codes")
}

// Append-only ledger of every loyalty movement. The signed `points` value is the
// source of truth (positive = credit, negative = debit); User.loyaltyPoints is a
// denormalized running total kept in sync inside the same transaction as each row.
model LoyaltyTransaction {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type      LoyaltyTxnType
  points    Int // signed: +earn/+refund, -redeem/-reverse
  reason    String
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([orderId])
  @@index([orderId, type])
  @@map("loyalty_transactions")
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  rating       Int
  title        String?
  body         String?  @db.Text
  reviewerName String?
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId, isApproved])
  @@index([userId])
  @@map("reviews")
}

model Banner {
  id           String    @id @default(cuid())
  title        String
  subtitle     String?
  imageDesktop String
  imageMobile  String?
  ctaText      String?
  ctaLink      String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?

  @@map("banners")
}

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String?
  content     String     @db.Text
  coverImage  String?
  authorId    String
  status      BlogStatus @default(DRAFT)
  metaTitle   String?
  metaDesc    String?
  tags        Tag[]
  scheduledAt DateTime? // when a SCHEDULED post should go public
  publishedAt DateTime? // when the post actually went public
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, scheduledAt])
  @@index([status, publishedAt])
  @@map("blog_posts")
}

// Every public/customer request (contact, callback, product inquiry, newsletter,
// order-modification, support) is persisted here BEFORE the admin notification is
// sent, so nothing is lost even if the notification channel fails.
model Submission {
  id        String         @id @default(cuid())
  type      SubmissionType
  name      String?
  email     String?
  phone     String?
  subject   String?
  message   String?        @db.Text
  orderId   String? // related order (order-modification)
  productId String? // related product (product inquiry)
  userId    String? // set when the submitter is authenticated
  meta      Json? // any extra structured fields (preferred callback time, etc.)
  handled   Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@map("submissions")
}

model Wishlist {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}
